# LinkedIn (copy from ../agentic-competitor-analysis/.env)
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Anthropic
ANTHROPIC_API_KEY=

# GitHub (optional but recommended — increases rate limit from 10/min to 30/min)
# Create at: https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# Supabase (fill in after creating project at supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Internal secret shared between Next.js and the Python pipeline API
# Generate with: openssl rand -hex 32
PIPELINE_API_SECRET=
