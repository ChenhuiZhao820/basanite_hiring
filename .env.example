# Anthropic
ANTHROPIC_API_KEY=

# ElevenLabs Conversational AI (voice interviewer)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Resend (candidate report delivery + admin notifications)
# NOTE: the Next.js app only loads web/.env.local, not this file — set
# RESEND_API_KEY / RESEND_FROM / ADMIN_NOTIFY_TO there too (and in the
# production web deployment's env vars) or admin notification emails
# will be silently skipped.
RESEND_API_KEY=
RESEND_FROM=Basanite <onboarding@resend.dev>

# Admin notification recipients (comma-separated). Emailed on new waitlist
# requests and security events. Falls back to OPS_ALERT_TO; if neither is
# set, the web app emails every account with app_metadata.is_admin.
ADMIN_NOTIFY_TO=
OPS_ALERT_TO=

# Supabase (fill in after creating project at supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Internal secret shared between Next.js and the Python pipeline API
# Generate with: openssl rand -hex 32
PIPELINE_API_SECRET=

# Test Mode (internal tester walkthrough) — dev/staging only, NEVER in
# production. Sessions started on the designated test role are stamped
# is_mock: small-talk interview, no reports, TEST-badged bottom-pinned
# dashboard row. Both must be set for any session to be mock.
TEST_MODE_ENABLED=
TEST_MODE_ROLE_ID=
