# Anthropic
ANTHROPIC_API_KEY=

# ElevenLabs Conversational AI (voice interviewer)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Resend (candidate report delivery)
RESEND_API_KEY=
RESEND_FROM=Basanite <onboarding@resend.dev>

# Supabase (fill in after creating project at supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Internal secret shared between Next.js and the Python pipeline API
# Generate with: openssl rand -hex 32
PIPELINE_API_SECRET=

# Recall.ai (Copilot bot-join for Google Meet)
# API key + workspace verification secret (whsec_...) from the Recall dashboard.
# PIPELINE_PUBLIC_URL is this FastAPI server's public https base URL — Recall
# delivers real-time transcript webhooks to {PIPELINE_PUBLIC_URL}/copilot/bot-webhook.
RECALL_API_KEY=
RECALL_REGION=us-east-1
# Newer Recall workspaces use a single workspace verification secret.
# Legacy workspaces may use RECALL_WEBHOOK_SECRET or RECALL_SVIX_WEBHOOK_SECRET.
RECALL_WORKSPACE_VERIFICATION_SECRET=
RECALL_WEBHOOK_SECRET=
RECALL_SVIX_WEBHOOK_SECRET=
PIPELINE_PUBLIC_URL=

# Test Mode (internal tester walkthrough) — dev/staging only, NEVER in
# production. Sessions started on the designated test role are stamped
# is_mock: small-talk interview, no reports, TEST-badged bottom-pinned
# dashboard row. Both must be set for any session to be mock.
TEST_MODE_ENABLED=
TEST_MODE_ROLE_ID=
